# ================================================================
# eCommerceKume — Variables de entorno
# Copiá este archivo como .env y completá los valores
# ================================================================

# ----------------------------------------------------------------
# En desarrollo: ecommerce_dev | En producción: ecommerce
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_dev"

# ----------------------------------------------------------------
# Mercado Pago
# Obtené las credenciales en: https://www.mercadopago.com.ar/developers
# ----------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Para pruebas en Sandbox, usá el Access Token de TEST
MP_PUBLIC_KEY=

# ----------------------------------------------------------------
# Resend (email de entrega de producto)
# Gratis hasta 3.000 emails/mes: https://resend.com
# ----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Kume <noreply@kume.com>"

# ----------------------------------------------------------------
# JWT — Secreto para tokens de admin y descarga
# Generá uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ----------------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------------
# Admin (primer usuario — usado en el seed)
# ----------------------------------------------------------------
ADMIN_EMAIL=admin@kume.com
ADMIN_PASSWORD=

# ----------------------------------------------------------------
# Exchange Rate API (mostrar precio en USD)
# Plan gratuito: https://www.exchangerate-api.com/
# ----------------------------------------------------------------
EXCHANGE_RATE_API_KEY=

# ----------------------------------------------------------------
# Storage — Railway Volume
# En Railway, el volumen se monta en /data
# ----------------------------------------------------------------
STORAGE_PATH=/data/files
PREVIEW_PATH=/data/previews

# ----------------------------------------------------------------
# URLs
# ----------------------------------------------------------------
# URL pública del backend API
API_URL=http://localhost:3001
# URL del frontend (para webhooks back_urls de MP)
SITE_URL=http://localhost:3000

# ----------------------------------------------------------------
# Next.js — variables públicas (prefijo NEXT_PUBLIC_)
# ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MP_PUBLIC_KEY=
