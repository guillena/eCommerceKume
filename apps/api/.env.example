# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ekume"

# App
PORT=3001
NODE_ENV=development
SITE_URL=http://localhost:3000
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Mercado Pago
MP_ACCESS_TOKEN=your-mp-access-token
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Kume <noreply@kume.com>

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# Storage (Railway Volume)
STORAGE_PATH=/data/files
PREVIEW_PATH=/data/previews

# Admin
ADMIN_EMAIL=admin@kume.com
ADMIN_PASSWORD=change-this-password
